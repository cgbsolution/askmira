# The FastAPI backend. Auth tokens are minted there, not by Supabase.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AskMira

# Server-only (never NEXT_PUBLIC_). The same value as the API's PROXY_SHARED_SECRET;
# lets the API see each person's address instead of Vercel's. See src/middleware.ts.
PROXY_SHARED_SECRET=

